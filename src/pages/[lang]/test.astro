---
import Base from '../../layouts/Base.astro';
import TestPlanner from '../../components/TestPlanner';
import { ITEM_TYPE_IDS } from '../../lib/generators';
import { dict, LOCALES, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const href = (path: string) => `${base}/${locale}/${path}`;
const p = dict(locale).pages.test;

/**
 * The page is a planner first and a runner second — see `TestPlanner`.
 *
 * With no query string it offers a time budget and a focus and builds a run to fit; with one it runs
 * it. The full test is one item per format, and the count is derived from the registry rather than
 * written down: a hard-coded length once left four formats silently unreachable, and deriving it is
 * what makes "full" true by construction.
 */
const items = ITEM_TYPE_IDS.length;
---

<Base locale={locale} title={p.title} description={p.description(items)} lede={p.lede(items)}>
  <div class="card quiz-stage">
    <TestPlanner client:only="preact" locale={locale} />
  </div>

  <p class="muted">
    <a href={href('test/short/')} data-testid="link-short-test">{p.shortLink}</a>
  </p>

  <section class="card prose-card">
    <h2 class="section-heading section-heading--xs">{p.differsHeading}</h2>
    <ul class="muted spaced-list">
      {p.differs(items).map((line) => <li>{line}</li>)}
    </ul>
  </section>
</Base>
