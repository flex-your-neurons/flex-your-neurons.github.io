---
import Base from '../../../layouts/Base.astro';
import Quiz from '../../../components/Quiz';
import { DOMAIN_ORDER, ITEM_TYPE_IDS } from '../../../lib/generators';
import { dict, LOCALES, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const href = (path: string) => `${base}/${locale}/${path}`;
const p = dict(locale).pages.testShort;
const items = DOMAIN_ORDER.length;

/*
 * One item per *domain*, not per format. The full test's length is derived from the registry so
 * that it reaches every format; this one's is derived from the domain list so that it reaches every
 * domain, and which format stands for each is drawn from the session seed inside the quiz — see
 * `onePerDomain`. The pool passed down is the whole registry; the draw happens where the seed is.
 */
---

<Base locale={locale} title={p.title} description={p.description(items)} lede={p.lede(items)}>
  <div class="card quiz-stage">
    <Quiz client:only="preact" mode="test" types={ITEM_TYPE_IDS} draw="one-per-domain" locale={locale} length={items} />
  </div>

  <section class="card prose-card">
    <h2 class="section-heading section-heading--xs">{p.whyHeading}</h2>
    <p class="muted">{p.why(ITEM_TYPE_IDS.length)}</p>
    <p class="muted">
      <a href={href('test/')} data-testid="link-full-test">{p.fullLink(ITEM_TYPE_IDS.length)}</a>
    </p>
  </section>
</Base>
